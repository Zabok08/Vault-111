{
  "name": "vault111-control-center-v3",
  "version": "3.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "env:ensure-local-direct-url": "node scripts/ensure-local-direct-url.mjs",
    "secrets:generate": "node scripts/generate-secrets.mjs",
    "owner:grant": "node scripts/grant-owner.mjs",
    "role:map": "node scripts/map-role.mjs",
    "sync:run": "node scripts/sync-faction.mjs",
    "client:configure": "node scripts/configure-client.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@prisma/client": "^6.8.2",
    "fastify": "^5.3.3",
    "jose": "^6.0.11",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "prisma": "^6.8.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  },
  "engines": {
    "node": ">=22"
  }
}
